# ===== 服务配置 =====
# 后端监听端口
PORT=3000
NODE_ENV=development

# ===== MySQL 配置 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=personal_blog

# 连接池上限（可选，默认 10）
DB_CONNECTION_LIMIT=10

# ===== 跨域配置 =====
# 允许的前端地址，多个用英文逗号分隔
CORS_ORIGIN=http://localhost:5173

# ===== 反向代理（可选）=====
# 部署在 Nginx / 负载均衡之后设为 1，才能拿到真实客户端 IP
TRUST_PROXY=0

# ===== 阅读次数接口限流（可选）=====
# 同一 IP 在窗口期内的最大请求次数
VIEW_RATE_WINDOW_MS=60000
VIEW_RATE_MAX=30

# ===== 游客留言接口限流（可选）=====
# 默认每 IP 每小时最多 3 条
MESSAGE_RATE_WINDOW_MS=3600000
MESSAGE_RATE_MAX=3

# ===== 匿名评论接口限流（可选）=====
# 默认每 IP 10 分钟最多 5 条
COMMENT_RATE_WINDOW_MS=600000
COMMENT_RATE_MAX=5
